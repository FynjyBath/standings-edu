# Runtime data and secrets (credentials live here)
/data/

# Generated standings and caches
/generated/

# Built binaries
/bin/

# Temp files from atomic writes
*.tmp
.tmp-*

# OS / editor noise
.DS_Store

# Favicons: не отслеживаются в git — каждый сервер держит свои
# (git pull их не заменяет). Файлы лежат в web/static локально.
/web/static/favicon.ico
/web/static/favicon*.png
/web/static/apple-touch-icon.png
